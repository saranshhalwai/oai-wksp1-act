{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "jsx": "react-jsx", "resolveJsonModule": true, "types": ["node", "vite/client"]
