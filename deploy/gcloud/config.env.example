# Copy to config.env. Public configuration only; no credentials or API keys.
GCLOUD_PROJECT_ID=
GCLOUD_REGION=asia-south1
GCLOUD_ZONE=asia-south1-a
GCLOUD_VM_NAME=pocket-tank-server
GCLOUD_MACHINE_TYPE=c4d-standard-4
GCLOUD_BOOT_DISK_GB=30
# Corrected from the prompt: C4D does not support pd-balanced.
GCLOUD_DISK_TYPE=hyperdisk-balanced
GCLOUD_IMAGE_PROJECT=ubuntu-os-cloud
GCLOUD_IMAGE_FAMILY=ubuntu-2404-lts-amd64
GCLOUD_NETWORK=artillery-workshop
GCLOUD_SUBNET=artillery-mumbai
GCLOUD_SUBNET_CIDR=10.74.0.0/24
GCLOUD_ADDRESS_NAME=artillery-workshop-ip
GCLOUD_ARTIFACT_REPOSITORY=pocket-tank
GCLOUD_RUNTIME_SA=artillery-runtime
GAME_DOMAIN=
ACME_EMAIL=
RELEASE_ID=
# Include https://GAME_DOMAIN and each actual participant origin. No wildcards.
ALLOWED_ORIGINS=
MAX_ROOMS=50
PHYSICS_WORKERS=1
WORKER_QUEUE_LIMIT=32
