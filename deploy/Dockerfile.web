FROM oven/bun:1.4.2 AS bun
FROM node:22.20.0-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
ARG BUILD_ID=local
ENV BUILD_ID=$BUILD_ID
RUN apt-get update && apt-get install -y --no-install-recommends zip unzip && rm -rf /var/lib/apt/lists/*
COPY . .
RUN bun install --frozen-lockfile && npm run build && npm run package:reference
FROM caddy:2.10.2-alpine
COPY --from=build /app/dist/neon /srv/neon
COPY --from=build /app/dist/paper /srv/paper
COPY --from=build /app/dist/downloads/artillery-lab-backend-reference.zip /srv/downloads/artillery-lab-backend-reference.zip
COPY --from=build /app/dist/index.html /srv/index.html
COPY --from=build /app/dist/version.json /srv/web-version.json
COPY deploy/Caddyfile /etc/caddy/Caddyfile
HEALTHCHECK --interval=15s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1:8081/healthz || exit 1
